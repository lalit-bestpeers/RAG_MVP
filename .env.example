# ------------------------------------------------------------------
# RAG MVP Environment Configuration
# ------------------------------------------------------------------

# --- App ---
APP_NAME=RAG MVP

# --- PostgreSQL (must match docker-compose.yml) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql+psycopg2://rag:rag@postgres:5432/rag

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=384

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-long-random-string 
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Embeddings ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- Grok (LLM) ---
GROK_API_KEY=paste-grok-free-api-key-from-grok-api-cloude
GROK_BASE_URL=https://api.groq.com/openai/v1
GROK_MODEL=openai/gpt-oss-20b
GROK_MAX_TOKENS=1024
GROK_TEMPERATURE=0.1

# --- Ingestion / RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# --- Document parsing ---
DOCUMENT_PARSER=opendataloader

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
