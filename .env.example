# ------------------------------------------------------------------
# RAG MVP Environment Configuration
# ------------------------------------------------------------------

# --- App ---
APP_NAME=RAG MVP

# --- PostgreSQL (must match docker-compose.yml) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql+psycopg2://rag:rag@postgres:5432/rag

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=384

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-long-random-string 
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Embeddings ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- Local LLM (HuggingFace) ---
# Any causal LM model from HuggingFace Hub. Auto-downloaded on first start.
# Good options (RAG needs a capable model, avoid the smallest ones):
#   Qwen/Qwen2-1.5B-Instruct        (~4 GB RAM, good quality/speed balance) [default]
#   TinyLlama/TinyLlama-1.1B-Chat-v1.0 (~2 GB RAM, weaker quality)
#   microsoft/Phi-3-mini-4k-instruct (~8 GB RAM, best quality)
LLM_MODEL=Qwen/Qwen2-1.5B-Instruct
LLM_DEVICE=auto
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1
LLM_TORCH_DTYPE=auto
LLM_CACHE_DIR=/app/model_cache
# Preload the model in a background thread at startup (so the first chat is fast).
# Set to false to load lazily on the first chat request instead.
LLM_PRELOAD=true

# --- Ingestion / RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# --- Document parsing ---
DOCUMENT_PARSER=opendataloader

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
